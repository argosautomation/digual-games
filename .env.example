# Deepseek API key for AI prompt generation. If unset, server falls back to a built-in prompt pool.
DEEPSEEK_API_KEY=

# Network
PORT=3201
HOST=127.0.0.1
PUBLIC_URL=https://digual.com/games

# Comma-separated list of origins allowed for Socket.IO CORS.
# Leave empty for "*" (wildcard) — fine in dev, NOT recommended in production.
ALLOWED_ORIGINS=https://digual.com

# Phase timing overrides (milliseconds). Defaults: 75s answer, 30s vote.
# ANSWER_MS=75000
# VOTE_MS=30000
